{
  "name": "mini-sk-pc",
  "version": "1.0.0",
  "description": "Mini SK para PC — editor com terminal do computador e Ollama",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "programa": "electron .",
    "exe": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikon.minisk.pc.nteste10281307",
    "productName": "Mini SK (teste 10281307)",
    "executableName": "Mini-SK-nteste10281307",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mini SK (teste 10281307)",
      "artifactName": "Mini-SK-nteste10281307-Instalar.exe"
    },
    "portable": {
      "artifactName": "Mini-SK-nteste10281307-sem-instalar.exe"
    }
  },
  "portaDoPrograma": 10011
}
